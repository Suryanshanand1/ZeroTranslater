## Release signing configuration.
##
## Copy to keystore.properties and fill in. keystore.properties is git-ignored.
##
## With this file absent, `./gradlew assembleRelease` still succeeds but produces an
## UNSIGNED APK (app-release-unsigned.apk). That artifact cannot be installed on a
## device and cannot be uploaded to Play, so a green assembleRelease is NOT evidence
## that the release build is shippable. Check the filename, or run:
##
##   apksigner verify --verbose app/build/outputs/apk/release/*.apk
##
## Generate a keystore with:
##   keytool -genkeypair -v -keystore release.jks -alias zerotranslater \
##           -keyalg RSA -keysize 4096 -validity 10000
##
## storeFile=path is resolved relative to the module directory (app/), not the repo root.
storeFile=../release.jks
storePassword=CHANGE_ME
keyAlias=zerotranslater
keyPassword=CHANGE_ME
