<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      ZeroTranslater opens no sockets of its own; translation happens entirely on
      device. android.permission.INTERNET arrives transitively from the ML Kit
      artifacts, which are the only component that needs it in order to fetch
      language packs from Play services. Verified with:
        ./gradlew :app:processDebugMainManifest
      See README -> "Permissions".

      The three below belong to the optional floating Quick-Translate pill. The
      overlay permission is only meaningful once the user turns the feature on,
      and Android provides no runtime dialog for it, so it is granted from system
      settings.
    -->

    <!-- Draw the floating pill above other apps. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Android 14+ requires a foreground service to declare an explicit type. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZeroTranslater">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ZeroTranslater"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The system-wide "Ztranslate" action.

          Registering for android.intent.action.PROCESS_TEXT with category DEFAULT
          is what makes this activity appear in the floating text-selection menu
          alongside Copy / Cut / Paste / Select all. android:label is what the
          system renders in that menu, so it is deliberately short.

          KNOWN REACH LIMITATION (documented in README): PROCESS_TEXT is only
          offered by apps that implement the ActionMode text-selection API.
          WebView-based apps, games, and many custom editors do not, so this action
          will not appear everywhere. Some OEM ROMs (notably MIUI/Xiaomi) strip
          third-party PROCESS_TEXT handlers entirely.
        -->
        <activity
            android:name=".ProcessTextActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/process_text_label"
            android:launchMode="singleTop"
            android:theme="@style/Theme.ZeroTranslater.Dialog">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!--
              The share sheet. This is the one text path that works inside
              WebView-based apps such as NotebookLM, which do not implement the
              ActionMode selection API that PROCESS_TEXT depends on. Plain text
              only: no EXTRA_STREAM, so nothing large or binary is pulled in.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
          Hosts the optional floating Quick-Translate pill.

          foregroundServiceType="specialUse" is required from Android 14, and the
          PROPERTY_SPECIAL_USE_FGS_SUBTYPE below is the declaration the platform
          asks for whenever a specialUse service starts. The subtype is stated
          plainly: this service draws a user-enabled translation control and reads
          nothing on its own.

          Note there is no <uses-permission> for clipboard access here, because
          there is none to declare. Clipboard access is granted by window focus,
          not by a permission, and the service deliberately never reads it.
        -->
        <service
            android:name=".quicktranslate.QuickTranslateService"
            android:exported="false"
            android:foregroundServiceType="dataSync">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Hosts a user-enabled floating translation control that opens the app's translate overlay when tapped." />
        </service>

    </application>

</manifest>
